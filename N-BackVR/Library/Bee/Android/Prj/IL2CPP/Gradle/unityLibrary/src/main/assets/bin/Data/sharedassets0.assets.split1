ש‏רעןףצעםםץעצצתûûקצפעץקתקü‏ûץממףפצקûףעננעףצץףששתû‎תûקץשקץץשצצנ‎ûץקרשקפטלמםסץפמםןםלטלליטכמףףלמחלםםמקרםךמללןףץץםיוןססקףץקעמןלחםץצףלםטךלכיכךמםמיחכץקץססכיצסןםלךםמנןםנעפמממץפשצתרלככעץסע‎üץרףעףפףקץקשסכמןסעעסעןמנקüרסקü‎‎‏ןרûסלקשפצרתףרקצפףצנןפששüסûשףסצףןמןנכיךנתרצץüרןףצûקקתתפצקûששצ‎‎ףסקשק‎קןמםףץקק‎ûרשנסףןףשצתשüû‎‏רץףצשקףשûתעûצתקû‏תשףשננןתקסםממךיללםלךלףעלםיםיםפששלמןמםנעעעמםמענסעעעףעמניככסףםךליךךןסששתצןנךלףעמכעיכרנלליוםכןיםכנףממע‎תפףסענסםלסספשףנשץמעעעףפüרנככטןמןסכללטמצקנרûüת‎נץןךכףנסץû‏תצשצמנןןףפתשûס‎üףעüקממסםםןםלקשצפ‎תמפü‎קרüüרפפשקשףעפסנרקצפםנעערûקקשû‎שקצפעףררצרûצתüתתץץûüפûתקüצקתפüüץךמûתשצתפףךםכךיכךכןיםצףלכטךימשüףלללכנסנמםלנסןנסלססקצרעןחכלללןכליסרתשûרצץמםכלנםכככלשםלמיןמכלכסלןעצעףשרקףעסססעסףעףץססרסךעעעץעקקסיכחלךןנםלמךיףקת‎û‏û‎שתנםךטנסנץשצשüףיםףץץףררצערצססעעסעענפםימןספפûסעüץץץמףץûרצתתרץלךסעמץסמןמףץשüצשרüÿתקןעףרץצצתץצפקרüפץשüקüûץ‏צתתקףמלזיû‎רקרףםךנמכככמכלךץûןלןמכייעסככםמטםןמללכםנמסעמנףצצץרקכמףסףפניכסרתצüûתûקסךממליךכנüןמןיעםךםכםנפףקרץתרפספףםםסףססעקפנענסץססעפתקûפמלננםמםמךחיפûüüרÿת‎ת‏תסךםענןןנפשץףממפףפעעףסףצתץקרצ‎üצןןטיךךםןץפנףרמלץןענקץפפ‎ש‎תסץüפפןסססףפûתתצששüשתפפצסץעצששקפצץשצץקרתקפפץפקשצםילזיץמכנצןםךנמכלךלמםםעץםםןםטכממנללכלךםכךכךןזןףעסםעףקפפרפןףü‎צשףץןןףרששץץתרקפןןןםםךלננעסכףמלמללםסעףץףצעסףצעכןףשעסספעעצססעעסףפןןףתססעסססלמםךכמרששץüפנפתשץקקפעףףמסûרקעפשץעףפצפףררץקקרשצפןלטטיןכםףפעףץףןצענךכמנסןף‎üשקתüץנץענענףןפקררûשקרצרצץץררקצקצףשרקץץעכמןערûûעינסיטחטכךככמלנןךלםכמסנןנךחלךמםללמלמיךימטמלםלזםשסנעפרצפקץםךמץ‎קננענמפשקûץףûץצקנסףןנמכםססצנןלננלכלסנפקצרץננמנכנסרפפצתרקשתץעץץףצןםעûסלסםנםכמטךךטש‎‏קüלחמקצממףשץףרענשףצ‏שתףנלךךמפרתףעסשקןמןןלכםמימףפרעץתשקפכטלםככויסררררûנמףננסףפסעפףפצףףץצץקףרקסעצפפצתרעעעמלםסמקשמךלתתףםטטךלכלמיןםךכלךםםםטככיכךלםימלימכייכלנסםךםעקעץףעקרףףסמםמךסצנםמץעףתתשףפצקצרכעףעמעפמנמןלעננסלםםסץשצץרשםלטךןןןןףףסנןףתûתרףץפפסןצשפיםככםםםלמלןר‎‏צüליםשתללערתשצצפרםנרררףכןככמםמקץןןעעךכלממיןםןשץפץץתûüשתעםמנחככםמפשץפףנעצףצפףףעעעפעףץפףפפץץןףסנףצףקףףסענלןםסםסןויךףת‏‏תשלמילכךמןטיכלמחךומילמךםממסנםסףמללעקשפףשףןעץצםןעסןמכלמלמממנסששץפעפצק‎תתץלןענמסנךןממסססןעלממעסץץסקקנלךזךכםךלךמיזלץרûשקשפענסצשףמעךחלןילןספרתשק‏צכעûשךןףתרÿףסקץעעפצפעךןכןיכינקנףעסמכםמםיימצפעץקפררק‏‎עןנעלממןממפסננענןנףנןסענפץקפףץץצץפûעפרץרשצקשןלםןלמץפןמללעכמת‏‎ÿרלטטטלךצציטךמםךםכנכסףכערש‏ûצצשפףןע‎תעשצםלנמנסננננםלךםלטילןםףעננףץקשת‎קץייןנשצןימסמנתעןנסןנףסערסףפמלךטזללטךףשרסמûתûףףרעעעעףקסמסמחימכמנעקקתץשûרםס‎קמןףןר‏üקפשץןעףינןןןםםףץנפעףנןנלןןממלףנסצרץשצשףû‎ףרשףףםךמםעתפûעתסןףממלמסןףףעעסעעעץףץץףקרת‎ûפרךטטןםךעעשסןערףרû‎תüםטלנמםלץשףסןםניכחםישקךןשרüפקצר‎ףסעפףמצצץפןננללםסעסנלךיךלמכמנערףףףרûתüקסךממןץענמעסנס‎סנםןסעפצûשסףנכםליטזליףתÿÿרץ‎üפעסץעףףעסנןנמסןננמעשûשקûרקרקןםסמםעפכףתתףסץפסףץכסססמעמנפפססיללםלמננניעםמצûררףקתצפפקמע‎סחליץשףקץשרעץנכפפסןעקפנלסעףעסנףסףץף‎üצץםךלןללסשûפלףעשûקץצ‎נלכממךנשûרצנכןכךטןחנכינרקתעןןנסףפצקפעןסספסםמםמפףעסממככםככךםףעûרקעףקפשüמךךמםםממיםסכןצסןמנפףץק‎שעךלכסיםטטמכת‎‏פמנרûםלנעסעסססנןנעעףנלםתûצצרשצפתצנךצשר‎ûםןקקףקףץףעןינסנםספמנמסעכןםלםכמלםכןךןצ‏ûûרץתלןרףלנררץפקצנמקשקעמפעןקרסםסףףץןנעעסנןעץףעמצפףרסננןלךןûץמטיםצתקתתÿתללטיכמםףüüתםןןםסקמהזיץת‎‏‏צלעלסרצקשץןןנןמסנעפץנעספץץץשûףשצנףת‏‏ץץקץץפנןםללילפמףףככןסןנסףףצקתץעייכןךךךךמלקרץךםנסץעמןנעעעספסמףפסנךלםü‎תüשףקפפמסנעתü‏ûןנתףןרעפצפנםסענלןסססףעקכמטזחינןטפףמםעצת‎צמעםןרצץףר‎‎‎‎שצענסףסממעמסעמנץננעףסנףץעעפפץןףףסןמןמןניכםמכךךילפÿתûצûצטכםמללללםנûקנלכםקתםחיü‎רת‏עךךלמקףüûפמםםםעפנסססססעףץקשסענצנספü‏‏קתתתפנןכילכיכרנץפמםמןסןנףקףצüשןטילםכלטטלייםטיכעץצףלפנקץעץפנםףצןטטכלûüûÿûקקנכנצעץתתקûץץרקשצצשעקעססםממםנמךץפשךייוזךמךךסרתףקûצצתפנךמסקצû‎ÿûûש‏שתפןסממםפנפסנסקףעץפםןפûפןפשץעעןסעמפךנעםלךךטככסץר‎ר‎פךיןלםןפטלךןמץתסלככןץסזיüûררקםממףנרר‎ûםללםםכעננספעעפעמןסםםמץםרסףרץקקשüןםךילכטלעצנלןעמנףעססעסןעûüסטטלככזחךלטחיךךםש‎ûסלרעעףעפננןקתלטךךלככנ‎üתקמןץüתü‎ü‏‎קרץצץצענסףנסעעעפמנםחמףרלכטחטטםזיןפרצףק‎ûקמללןעקץףתתץüץשר‏תץפמלנצקששצנססףשץמםפרצסעצתüץלמןמעפעענםןךטחךףתקüü‎צעמםלמןנלנטחםקרפקנמךםטזכ‏תץקסכמנרשררפקליכלזחמםמקפעעעססעףנסנעץצניךרשעמילכחילןכספץפםןפןסעעססעססמםûצךךםםמייםנךטכיימשû‎ףכןןפקםנמןסûתמחכמנלםעתרקקנרü‏‎ûûתüרקץעףןלסלנעףנסעצץעכךךךסעכךיכטילככסמצשץץרקפסלכןשקעעש‎ûקעףצ‎פרשקףתקספףףםנםעצץכךעץררפעענעננךטמכלמנמסמטלךכנעצצפעפרןכםןלימךךםצתץצףענמכןעששעצןןנןספענףספסנןםםמףנפרץפעףץעצססנסנםממףפפסממנלןנןנןמפפץעסנעףססעססססןנץףכךמםןםלכםנםןםםךץûקסמסןספנןמםמנמןטנû‏סטלנףצקסשרררתûûÿשץפץקץעפפפתרעסססץףךוילמיחםטחזלםכךץפץףקשרתץצנלעשצפפף‏ררסעפüץרתקעתשףקקץץצרצצףמלףףתקכמעעעקנלךןםןמםלכיזךךךכםמםלןכפמךמלםללחכךעתקץסםממסרûü‏‎עעתםטמכלםסץצעןסךמצתלטךכעץקצףצססלךטזךלךםכלכמננמססףןסףסעמסכסףףעעקעםמעלתפךםנםםךכךיכילייטםüûםככךיךןליככטזםרתÿ‏ףכןלכשץןתü‏שש‎üרפקüצת‎צצרעששעפףףשףחזךלכךטםכזכםכייûשרפק‎‎ÿשרעכנשףץץקרקתשתקûתץרףקתשרפץפץץקףפןלכסץרסךכףפץתףםזכםלללכיכךכטימנןכחםכנעטםיכםיךיכםםעעםנקץץףפףüתצץרפךנכםנחסצץןץצףףפעחהכצץסףקקףןעםטמצץףתקקעתקץצצקרתשפעסענןנעססףפעמןסםעףכלןףפןכמלםללליזםתתםךלםככיםטםכטטס‏‏ÿÿ‏‎ררתשןמצקתüתתצü‏‏‏צûüקףפערץעעןפûץחוולםימללחךךךזטüשצעפשתתצפקתתשץפףרקץתשרצפפץשצûרתתצüצ‎‎ץקץףךלסתשפםמרננןםסילללםםיךםםלךיםעםלחככךנכמךלםליטטטלנילמרץףעףףץשרשתפםכיםפטןצפלןûשףרתצעמצשפץצצצקץפסצתüתקרקרûצ‎‏üערת‎שקףרףםמעסןנעףענמןףףממךךמםםיחחחחכוזסûקץםלכףכחטטללעשרתת‏‏‏‎ü‎ûרפלייןתרק‎üü‏ü‏û‎פשצףששףעקץ‏שכטטינכסנלטםיככךספעץקüüûצרצüצצצצתתצשקףצצצףששר‎תקצףûק‎üשתץןלעץררûקפרןמםנסםככנםםךיטכיךטכךםלטכךחםכעכמםלוחחךלןךנעצפפןפעקתמםממנכטךעחחטםלמץצעקק‎‏פםץקצףסףקץשפןץערûמטק‎ûשüקרקתשצץעףרסלנםכלףתףנננעףפףנםןןממטיטויטעששףעססךסכךיימץ‏‏ףלמ‏‏תü‏שמצüמכעעעתצצסןתץ‎ÿûקרףףצץצצûת‏קציווןנרשמימםטחםשקקקןק‎ûקתףשצתצמץתצשüצקץץקקשüûצרקעשר‎תתשûנכפקûקרפצ‎עךםמךצםןנפפפךךמכטטךםלטייךזככמלןככטטוללןךמץץסצפץת‎פלףםכמךטכסטטכץקממעעעק‎‏קץקשקןנשüתפףץצשûסםםץרעמשףצפרתץנםענךיךךטךסץסנכללףמממלנננמןמכילםפצןםנפקסןסכטחצ‎‏צטכישרךעתסצפûףסףץüûלללספחüûשסשסעק‎רץüûץיןץםטםממלכטיםכחןüשûשלכשüשעפûתûפכפתûרûûûץצרקרששץשצתתרתששתûקךפשûששרץûציךנכלףצûרצüמככךטטחלךייטטזיךמםןךחווכממםטלממנץץפתצנכעםכלילםןגחחףשנמסןמש‏‎ק‎üûרםûתףנןמטטךףםךןןךםךקüûשרתûצףעעךיךךכםכמץףןםיסלטמןמםםנזחחךלךלמככסעניכנלךנ‎ש‎נטםזיטחחפקûץץץעןץרûסםשתרלתû‎רתרץצ‎צפשûעךטחךךלםןלךוךלטיכתצר‎ממצשקשûרüûקקüשüקüû‎ץסמפףעצתרףשרצתû‎‎‏‎קץשת‎ûüקüשלןüרענצÿףנמכטטכטלךכךךסצםזךכמםלסנילמנףסמנסלמû‎ףספםלפנניחכייזכטלנףללךןן‎‏ר‎ûתûקüרמנמךזילכזימחיןםפרשץעןנעסססלכממןפכמץצןםךמסטםמממזךיטכמטיטכטךערנמםמםםש‎רפטךםטחייזץש‎קעקשüשעףנןüüüףת‏ץעסüררüקקü‏נמםכךךןכלליךםםיךןפעפקפששקרתררקשפשûץץצüüתצנםעםףפûüצשתרר‏‏ü‎ûüק‎תתר‏ת‏רףץ‎ÿ‏שסüכלטיךככךלטךחכר‏פזכנעכנףכךמךמססםסןךףûקףקרסןפעןחייזטךיטלמניךכלםררץצץר‏ת‎פמנללךמכזחיטיכנךלפפעךילכססעכןפרשףלםספכךטכנכממךככמטוטחיחחלטחטלחכןמךםסצפךזכמכךלךןמףûץקû‏ûקערץעץרתצûüץנלןצפתקצשתןלףסכימטכלזכלםליץףןננעתפקתרקרקצקצûתתצצרקרקמננצקû‎רץתרצצûרפפקצשףתרתקûצפפצרüשררעםללכלכיךיםלםסרעףצצפססנךםממםכםמףףךננלעשרפמץנםטיזיזטםךכמיטממןןףשקצפפ‎צÿפמןלממנמםחלכךסןךךמןמטךימסעעףץרפûצסלעמחיימםלסםיךמםלטטלןלךןחיךיטםמםםםכרףלךמנםךכנתףןסצפצתצשרשקץסןצûÿשקעסןפץשüצתתרמןןןיככלךיםסכןךץעןםלעץףפקררüשüתפץתüשקעןנןםמןקשתשרץץתתרûתûרפקשק‎תרץשüקקשרûצשעעפשףטםךכככלכםלץת‏û‎û‎ןיםסנףןמסעעעןעפןערנכםעףללחיךיכנךמילמסםםןףüתץפףûץüרנננססנללחילינךךםןננלןסנסנסץרקקüûרממםמעלןממןליילךטילתשליךחיסככךנףסןעûפיטסנמנסערץנץץפקרףץתרץסכן‏‎‏תקמענפררקקרû‏צסלמםכךמלךלםםכםפתץמןעפפערששקץשקץץשûקקסןםסעפפשתת‎שקפפפקûצצףןששפר‎קעץתץצרûפףץפעפץûףממעקקכךךחפ‎ûûÿת‎סעפףןןכספסןןספעעןנפסעץץףךלםךמןכםמלמםףןנןעקפסעעסעקץףעןנףץסנןססלסמןםללנכמסנףעסףרצרûתעיילםלעפםיממממנםךיטףסכזךייûנחכקצלטםשסיךנלצüרעעםמנפץרפמנצץנןעפ‏‏‎ûעסנףפרûצץררûץןמןסםממכםךםלםמןעןםלןצûרקץûתרüûץץצפץעםןףקעץרקשץת‎רצרשûתרשצערפפרצשססףפצûתקקפםמעףרש‏שתתסםטחחיר‏‏‎‏‏ץץצסיכלנפמנעףקפנםכקססממעטטטחחחהלטזטיםכמלףפץצפץתףרקףעעעעןןמכמכיכליטימכךלןנעצק‎‎תשûרםךךמלכפץמיםיןםןנןלזכטללכךךץנמץןלמןןךםלךינ‎‏צנעםםלפצפסנץץץפצתüü‏‎ררףףקסץנלעףפûפסןןנסםסםיכןמםמנמסנןםסש‎‎שתרצשüקצתרקפפצףצפפשקתקר‎שקץק‎‏רשצץפשקקלûקםנץשש‏רקקעססמלמעעףמךםזטטטףûû‏ÿüןלףצםנמססמנסצסמפמןנםצץןץםיטכטוטםךוטךמעצקשץפץףפצפשץעססססנספסנםכככליךמםמעףץרצרתüûüüץחחךלםלשצלנןלםםלןנלךטכלךלכלמצקצנכמםלטמךחךסüüץםרתעםמרצםץשףתקü‎קת‎üü‎קץץפפםטנלנףףעםןןנןנלככנםןםסמןןןנןןערûשץץץצררקתשקתשפפפפצפףפצרפקףץת‏רץףפצשתתעתצןןץעף‎רץפרקףםטטכלטטילךכיךק‏‎ÿÿשסטףûןףןףםןנסףםנעמםעספץסףסםיטךזכךכסשüשצצת‏‎ץףףפץץץףענסנעססץףנכךממםמכםילפתקקרשתüûתüןוטךםםמ‎שךכלזחמלןליכליזךךטםףüקןסןלכךטסקםכנכנכסץצקםמףץנץרקפקצÿ‏üר‏‏ÿשפץפרצלםכםםנמטמנןכמםכננךעלמנןםכיןסןקü‎ץצףץûעץרצרüüץעףפץסלמצרףצףצץשצשקצקüûרצשüסןףקפ‎תקקקרףמךוחככךחךיךחזסÿÿÿÿ‏תלפפמעםמעעיןתענססמרףנתעףץןמכיכצץûÿ‎ÿרקûשרüפףפפפףעפעסםיסקץפץסןםםךככךךחכתשרפ‎רצ‎ש‏ûיזכםלךן‎ûןעעטטלךםכלקץכטךםסצקענרןכםךחחסûקםןכיןתסףצמלסקרצקקץשק‎ש‎שüü‏רץרפקûנמםםמממממנמםםממממנפןססןלךךצצתתûûצץצרûעץרצתרצץפץרסננעüüצשûקפקקתש‎שתûץשרששנמצûÿתתצתצמחםהטךכ